# Offline voorbeeld. Geen secrets of echte account-ID's invullen in dit bestand.
BESC_SOCIAL_INBOX_ENABLED=false
BESC_SOCIAL_INBOX_RECEIVE_ENABLED=false
BESC_SOCIAL_INBOX_SELECTIONS=[]
# Aparte, standaard uitgeschakelde knop om via Meta extra leesrechten voor directe
# berichten aan te vragen. Heeft geen effect op ontvangst of statistiekensynchronisatie.
BESC_META_INBOX_CONSENT_ENABLED=false
# Een toekomstige serverselectie bevat key, label en target met
# organization_id/account_id/platform/external_account_id/page_id/kind/resources.
# META_GRAPH_API_VERSION, META_APP_ID en META_APP_SECRET blijven serverconfiguratie.
