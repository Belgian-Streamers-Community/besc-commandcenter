import test from'node:test';import assert from'node:assert/strict';import{readFileSync}from'node:fs';import{createRequire}from'node:module';import{runInNewContext}from'node:vm';import ts from'typescript';import*as bounded from'../src/lib/crm-bounded-receive.ts';
const native=createRequire(import.meta.url),id='11111111-1111-4111-8111-111111111111';
function fixture(main=true,enabled=true){
 const calls:string[]=[];
 const mocks:Record<string,unknown>={'server-only':{},'./crm-bounded-receive':bounded,'./crm-communication-runtime':{readCrmCredentialBinding:async()=>{calls.push('credential');return{client_id:'FAKE',client_secret:'FAKE',refresh_token:'FAKE'};}},'./supabase/admin':{createAdminClient:()=>({rpc:async(name:string)=>{calls.push(name);return{data:{state:'done'},error:null};}})}};
 const fetcher:typeof fetch=async(input,init)=>{const url=String(input);calls.push(url);assert.equal(init?.redirect,'error');return new Response(JSON.stringify(url.includes('/token')?{access_token:'FAKE',scope:'https://www.googleapis.com/auth/gmail.metadata'}:url.includes('/userinfo')?{sub:'FAKE',email:'fixture@example.invalid',email_verified:true}:{id:'FAKE_MESSAGE',threadId:'FAKE_THREAD',payload:{headers:[{name:'Subject',value:'TESTFIXTURE - NIET PUBLICEREN'}]}}));};
 const compiled={exports:{}};runInNewContext(ts.transpileModule(readFileSync(new URL('../src/lib/crm-bounded-runtime.ts',import.meta.url),'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,{module:compiled,exports:compiled.exports,process:{env:{BESC_CRM_COMMUNICATION_ENABLED:String(main),BESC_CRM_BOUNDED_RECEIVE_ENABLED:String(enabled)}},fetch:fetcher,URLSearchParams,AbortSignal,Error,require:(key:string)=>key in mocks?mocks[key]:native(key)});
 const api=compiled.exports as{dispatchBoundedCrm:(grant:string,owner:bounded.BoundedOwner)=>Promise<unknown>};return{calls,api};
}
for(const[main,enabled]of[[false,true],[true,false]])test('runtime requires both feature flags '+main+'/'+enabled,async()=>{const f=fixture(main,enabled);await assert.rejects(f.api.dispatchBoundedCrm(id,async()=>{f.calls.push('owner');}),/disabled/);assert.deepEqual(f.calls,[]);});
test('denied claim causes zero credential reads, OAuth or Google calls',async()=>{const f=fixture();await assert.rejects(f.api.dispatchBoundedCrm(id,async()=>{throw Error('DENIED');}));assert.deepEqual(f.calls,[]);});
test('already claimed request after restart never reads credential or refreshes',async()=>{const f=fixture();assert.deepEqual(await f.api.dispatchBoundedCrm(id,async()=>({state:'claimed'})),{state:'claimed'});assert.deepEqual(f.calls,[]);});
test('authorized runtime uses explicit binding after claim, identity and one message, then private commit',async()=>{const f=fixture(),ops:string[]=[];const owner:bounded.BoundedOwner=async op=>{ops.push(op);return op==='claim'?{state:'claimed',nonce:id,connection:{id,organization_id:id,kind:'gmail',owner_email:'fixture@example.invalid',subject_id:'FAKE',enabled:true,valid_until:'2030-01-01',retain_until:'2030-02-01'},selection:{kind:'gmail',external_id:'FAKE_MESSAGE'},expires_at:'2030-01-01'}:{ok:true};};assert.deepEqual(await f.api.dispatchBoundedCrm(id,owner),{state:'done'});assert.equal(ops[0],'claim');assert.equal(f.calls[0],'credential');assert.equal(f.calls.filter(x=>x.includes('/token')).length,1);assert.equal(f.calls.filter(x=>x.includes('/messages/')).length,1);assert.ok(!f.calls.some(x=>/threads|connections|send/.test(x)));assert.equal(f.calls.at(-1),'crm_bounded_commit');});
