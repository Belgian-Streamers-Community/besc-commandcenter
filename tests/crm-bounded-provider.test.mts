import test from 'node:test';import assert from 'node:assert/strict';
import {boundedGoogleProvider,boundedSelection,receiveBoundedCrm,type BoundedSelection}from'../src/lib/crm-bounded-receive.ts';
const id='11111111-1111-4111-8111-111111111111',scopes=['https://www.googleapis.com/auth/contacts.readonly','https://www.googleapis.com/auth/gmail.metadata'];
const contact={resourceName:'people/FAKE',metadata:{sources:[{type:'CONTACT',id:'FAKE',etag:'FAKE'}]},names:[{displayName:'TESTFIXTURE - NIET PUBLICEREN'}],emailAddresses:[{value:'fake@example.invalid'}]};
const mail={id:'FAKE',threadId:'FAKE_THREAD',payload:{headers:[{name:'Subject',value:'TESTFIXTURE - NIET PUBLICEREN'},{name:'From',value:'fake@example.invalid'},{name:'Message-ID',value:'<fake@example.invalid>'}]}};
const connection={id,organization_id:id,kind:'gmail' as const,owner_email:'fixture@example.invalid',subject_id:'FAKE_SUBJECT',enabled:true as const,valid_until:'2030-01-01',retain_until:'2030-02-01'};
function mock(answer:unknown,granted=scopes){const calls:URL[]=[];return{calls,provider:boundedGoogleProvider({token:'FAKE',scopes:granted},(async(url:string|URL|Request,init?:RequestInit)=>{assert.equal(init?.method,'GET');assert.equal(init?.redirect,'error');calls.push(new URL(typeof url==='string'?url:url instanceof URL?url.href:url.url));return new Response(JSON.stringify(answer));})as typeof fetch)};}
test('bounded contact requests only one fixed CONTACT and minimal fields',async()=>{const f=mock(contact);const item=await f.provider.read({kind:'contacts',external_id:'people/FAKE'});assert.equal(f.calls.length,1);const u=f.calls[0];assert.equal(u.pathname,'/v1/people/FAKE');assert.equal(u.searchParams.get('personFields'),'metadata,names,emailAddresses');assert.equal(u.searchParams.get('sources'),'READ_SOURCE_TYPE_CONTACT');assert.ok(!u.searchParams.has('pageToken'));assert.ok('phones'in item&&item.phones.length===0);});
test('bounded mail uses messages.get and exactly five headers, without body',async()=>{const f=mock(mail);const item=await f.provider.read({kind:'gmail',external_id:'FAKE'});assert.equal(f.calls[0].pathname,'/gmail/v1/users/me/messages/FAKE');assert.deepEqual(f.calls[0].searchParams.getAll('metadataHeaders'),['From','To','Subject','Date','Message-ID']);assert.ok('body'in item&&item.body===''&&item.format==='metadata');});
for(const [name,value]of [['multiple contacts',{connections:[contact,contact]}],['extra phone',{...contact,phoneNumbers:[{value:'FAKE'}]}],['wrong person',{...contact,resourceName:'people/OTHER'}],['directory source',{...contact,metadata:{sources:[{type:'PROFILE',id:'FAKE',etag:'FAKE'}]}}],['deleted contact',{...contact,metadata:{...contact.metadata,deleted:true}}]]as const)test('bounded provider rejects '+name,async()=>{const f=mock(value);await assert.rejects(f.provider.read({kind:'contacts',external_id:'people/FAKE'}));});
for(const [name,value]of [['whole thread',{id:'FAKE',messages:[mail,mail]}],['snippet',{...mail,snippet:'PRIVATE'}],['body',{...mail,payload:{...mail.payload,body:{data:'PRIVATE'}}}],['wrong message',{...mail,id:'OTHER'}],['duplicate headers',{...mail,payload:{headers:[{name:'Subject',value:'a'},{name:'subject',value:'b'}]}}],['unselected header',{...mail,payload:{headers:[{name:'Bcc',value:'PRIVATE'}]}}]]as const)test('bounded provider rejects '+name,async()=>{const f=mock(value);await assert.rejects(f.provider.read({kind:'gmail',external_id:'FAKE'}));});
test('missing metadata scope never falls back to broader Gmail permission',async()=>{const f=mock(mail,['https://www.googleapis.com/auth/gmail.readonly']);await assert.rejects(f.provider.read({kind:'gmail',external_id:'FAKE'}),/scope/);assert.equal(f.calls.length,0);});
test('selection cannot contain full format, discovery, path traversal or arrays',()=>{for(const v of [{kind:'gmail',external_id:'FAKE',format:'full'},{kind:'contacts',external_id:'people/../me'},[{kind:'gmail',external_id:'FAKE'}]])assert.equal(boundedSelection.safeParse(v).success,false);});
test('oversized response is rejected before projection or storage',async()=>{const f=mock({...mail,oversized:'x'.repeat(33000)});await assert.rejects(f.provider.read({kind:'gmail',external_id:'FAKE'}),/provider_not_confirmed/);});
function flow(options:{state?:string;failure?:string;lostCommit?:boolean;expired?:boolean;revokeAtCheck?:number}={}){
 let claimed=false,done=false,stopped=false,reads=0,credentials=0,commits=0,checks=0;const events:string[]=[];
 const owner=async(op:string)=>{events.push(op);if(op==='claim'){if(claimed)return{state:done?'done':'claimed'};claimed=true;return{state:options.state??'claimed',nonce:id,connection,selection:{kind:'gmail',external_id:'FAKE'},expires_at:options.expired?'2000-01-01':'2030-01-01'};}if(op==='check'){checks++;if(options.failure==='revoked'||checks===options.revokeAtCheck)throw Error('revoked');}if(op==='status')return{state:done?'done':'claimed'};if(op==='stop'){stopped=true;return{state:'cancelled'};}return{ok:true};};
 const deps={provider:async()=>{credentials++;return{identity:async()=>{if(options.failure==='identity')throw Error('no');},read:async(selection:BoundedSelection)=>{reads++;if(options.failure==='network')throw Error('no');return mock(mail).provider.read(selection);}};},commit:async()=>{commits++;done=true;if(options.lostCommit)throw Error('lost reply');return{state:'done'};}};
 return{owner,deps,events,snapshot:()=>({stopped,reads,credentials,commits})};
}
test('global disabled causes no claim, credentials or network',async()=>{const f=flow();await assert.rejects(receiveBoundedCrm(id,f.owner,f.deps,false),/disabled/);assert.deepEqual(f.events,[]);});
test('claim is consumed before credentials and never reclaimed on a second call',async()=>{const f=flow();assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'done'});assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'done'});assert.equal(f.events[0],'claim');assert.equal(f.snapshot().reads,1);assert.equal(f.snapshot().commits,1);});
test('interrupted claimed run cannot fetch again after process restart',async()=>{const f=flow();await f.owner('claim');assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'claimed'});assert.equal(f.snapshot().credentials,0);});
test('expired grant stops before credentials',async()=>{const f=flow({expired:true});assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'attention'});assert.equal(f.snapshot().credentials,0);assert.ok(f.snapshot().stopped);});
for(const failure of ['identity','network','revoked'])test('failure '+failure+' never automatically retries or commits',async()=>{const f=flow({failure});assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'attention'});assert.equal(f.snapshot().commits,0);assert.ok(f.snapshot().reads<=1);});
test('lost commit answer is resolved by durable status without another fetch',async()=>{const f=flow({lostCommit:true});assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'done'});assert.equal(f.snapshot().reads,1);assert.equal(f.snapshot().stopped,false);});
test('revocation after identity stops before the selected item is fetched',async()=>{const f=flow({revokeAtCheck:3});assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'attention'});assert.equal(f.snapshot().reads,0);assert.equal(f.snapshot().commits,0);});
test('revocation after the selected answer stops before commit',async()=>{const f=flow({revokeAtCheck:4});assert.deepEqual(await receiveBoundedCrm(id,f.owner,f.deps,true),{state:'attention'});assert.equal(f.snapshot().reads,1);assert.equal(f.snapshot().commits,0);});
