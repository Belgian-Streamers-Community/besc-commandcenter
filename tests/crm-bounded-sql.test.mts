import test,{before,after,beforeEach,afterEach}from'node:test';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{readFile}from'node:fs/promises';
import{f1Database,q,j}from'./helpers/f1-database.mts';
import{receiveBoundedCrm,boundedGoogleProvider,type BoundedOwner}from'../src/lib/crm-bounded-receive.ts';
let f:Awaited<ReturnType<typeof f1Database>>,connection:string,session:string,grant:string;
const item={external_id:'FAKE',thread_id:'FAKE_THREAD',message_id:'<fake@example.invalid>',subject:'TESTFIXTURE - NIET PUBLICEREN',from:'fake@example.invalid',to:'admin@fixture.invalid',date:'2026-11-18',body:'',has_attachments:false,format:'metadata'};
before(async()=>{f=await f1Database();await f.owner();await f.db.exec('alter table auth.sessions add column not_after timestamptz');await f.db.exec(await readFile(new URL('../supabase/local/c10-bounded-receive.sql',import.meta.url),'utf8'));});after(async()=>{await f?.db.close();});
async function actor(user=f.ids.admin,s=session,role='authenticated'){await f.actor(user,role);await f.db.exec(`select set_config('request.jwt.claims',${q(JSON.stringify({sub:user,role,session_id:s}))},false)`);}
async function call(action:string,g=grant,o=f.ids.org){return(await f.db.query<{v:Record<string,unknown>}>(`select public.crm_bounded_owner(${q(o)},${q(action)},${q(g)}) v`)).rows[0].v;}
async function commit(nonce:string,value:unknown=item){await actor(f.ids.admin,session,'service_role');return(await f.db.query<{v:Record<string,unknown>}>(`select public.crm_bounded_commit(${q(grant)},${q(nonce)},${j(value)}) v`)).rows[0].v;}
async function deny(op:()=>Promise<unknown>,pattern=/bounded|permission denied/){await f.db.exec('savepoint denied');try{await assert.rejects(op(),pattern);}finally{await f.db.exec('rollback to savepoint denied;release savepoint denied');}}
beforeEach(async()=>{await f.owner();await f.db.exec('begin');connection=randomUUID();session=randomUUID();await f.db.exec(`update auth.users set email_confirmed_at=clock_timestamp() where id=${q(f.ids.admin)};insert into auth.sessions(id,user_id)values(${q(session)},${q(f.ids.admin)});insert into private.crm_connections(id,organization_id,kind,owner_email,subject_id,enabled,valid_until,retain_until,created_by)values(${q(connection)},${q(f.ids.org)},'gmail','admin@fixture.invalid','FAKE',false,clock_timestamp()+interval '7 days',clock_timestamp()+interval '30 days',${q(f.ids.admin)});insert into private.crm_connection_access values(${q(connection)},${q(f.ids.admin)},true,false,false);`);grant=(await f.db.query<{v:string}>(`select private.crm_bounded_issue(${q(connection)},${q(f.ids.admin)},${q(session)},'FAKE',clock_timestamp()+interval '10 minutes') v`)).rows[0].v;await f.db.exec(`update private.crm_connections set enabled=true where id=${q(connection)}`);await actor();});
afterEach(async()=>{await f.db.exec('rollback');await f.owner();});
test('mock Google -> authenticated claim -> service commit -> existing read-only workspace is one complete chain',async()=>{
 const requests:string[]=[];
 const transport:typeof fetch=async input=>{const url=String(input);requests.push(url);return new Response(JSON.stringify(url.includes('userinfo')?{sub:'FAKE',email:'admin@fixture.invalid',email_verified:true}:{id:'FAKE',threadId:'FAKE_THREAD',payload:{headers:[{name:'Subject',value:'TESTFIXTURE - NIET PUBLICEREN'},{name:'From',value:'fake@example.invalid'}]}}));};
 const port:BoundedOwner=async op=>{await actor();return call(op);};
 const deps={provider:async()=>boundedGoogleProvider({token:'FAKE',scopes:['https://www.googleapis.com/auth/gmail.metadata']},transport),commit:async(_id:string,nonce:string,value:unknown)=>commit(nonce,value)};
 assert.deepEqual(await receiveBoundedCrm(grant,port,deps,true),{state:'done'});
 assert.deepEqual(await receiveBoundedCrm(grant,port,deps,true),{state:'done'});
 assert.equal(requests.length,2);assert.ok(requests[1].includes('/messages/FAKE?'));
 await actor();const view=(await f.db.query<{v:{incoming:{payload:{body:string}}[]}}>(`select public.crm_communication_owner(${q(f.ids.org)},'overview',${q(connection)}) v`)).rows[0].v;
 assert.equal(view.incoming.length,1);assert.equal(view.incoming[0].payload.body,'');
});
test('read-only ACL can claim only the one provisioned run and commit to existing incoming view',async()=>{const claim=await call('claim');assert.equal(claim.state,'claimed');assert.deepEqual(await commit(String(claim.nonce)),{state:'done'});await actor();assert.deepEqual(await call('status'),{state:'done'});const view=(await f.db.query<{v:{incoming:unknown[];access:unknown;runs:{pages:number}[]}}>(`select public.crm_communication_owner(${q(f.ids.org)},'overview',${q(connection)}) v`)).rows[0].v;assert.equal(view.incoming.length,1);assert.deepEqual(view.access,{can_write:false,can_approve:false});assert.equal(view.runs[0].pages,1);});
test('second claim and replayed commit cannot consume a second item',async()=>{const c=await call('claim');assert.deepEqual(await call('claim'),{state:'claimed'});await commit(String(c.nonce));assert.deepEqual(await commit(String(c.nonce)),{state:'done',replayed:true});await f.owner();assert.equal((await f.db.query<{n:number}>('select count(*)::int n from private.crm_incoming')).rows[0].n,1);});
test('restart preserves claim and disallows a replacement run even after cancellation',async()=>{await call('claim');await actor();assert.deepEqual(await call('claim'),{state:'claimed'});await call('stop');await f.owner();await f.db.exec(`update private.crm_connections set enabled=false where id=${q(connection)}`);await deny(()=>f.db.query(`select private.crm_bounded_issue(${q(connection)},${q(f.ids.admin)},${q(session)},'OTHER',clock_timestamp()+interval '5 minutes')`),/existing_attempt/);});
test('wrong user, session, organisation and unknown grant rejected',async()=>{await actor(f.ids.chair);await deny(()=>call('claim'));await actor(f.ids.admin,randomUUID());await deny(()=>call('claim'));await actor();await deny(()=>call('claim',grant,f.ids.otherOrg));await deny(()=>call('claim',randomUUID()));});
test('expiry before claim rejected',async()=>{await f.owner();await f.db.exec(`update private.crm_bounded_grants set issued_at=clock_timestamp()-interval '20 minutes',expires_at=clock_timestamp()-interval '10 minutes' where id=${q(grant)}`);await actor();await deny(()=>call('claim'),/expired/);});
for(const change of ['expiry','revoke','disable','acl','session','membership'])test('commit rechecks '+change,async()=>{const c=await call('claim');await f.owner();const sql=change==='expiry'?`update private.crm_bounded_grants set issued_at=clock_timestamp()-interval '20 minutes',expires_at=clock_timestamp()-interval '10 minutes' where id=${q(grant)}`:change==='revoke'?`update private.crm_bounded_grants set revoked_at=clock_timestamp() where id=${q(grant)}`:change==='disable'?`update private.crm_connections set enabled=false where id=${q(connection)}`:change==='acl'?`update private.crm_connection_access set can_read=false where connection_id=${q(connection)}`:change==='session'?`delete from auth.sessions where id=${q(session)}`:`update public.organization_members set role='member' where user_id=${q(f.ids.admin)} and organization_id=${q(f.ids.org)}`;await f.db.exec(sql);await actor(f.ids.admin,session,'service_role');await deny(()=>commit(String(c.nonce)));});
test('no compose, send, apply, grant or ordinary run authorisation via bounded permission',async()=>{for(const op of ['compose','send','contact_decide','grant','authorize'])await deny(()=>call(op),/action_denied/);await deny(()=>f.db.query(`select public.crm_communication_owner(${q(f.ids.org)},'authorize',${q(connection)},'{}')`),/access_denied/);});
test('authenticated caller cannot commit, issue or read private grant rows',async()=>{await deny(()=>f.db.query(`select public.crm_bounded_commit(${q(grant)},${q(randomUUID())},${j(item)})`));await deny(()=>f.db.query(`select private.crm_bounded_issue(${q(connection)},${q(f.ids.admin)},${q(session)},'FAKE',clock_timestamp()+interval '2 minutes')`));await deny(()=>f.db.query('select * from private.crm_bounded_grants'));});
for(const value of [[item,item],{...item,external_id:'OTHER'},{...item,body:'PRIVATE'},{...item,snippet:'PRIVATE'},{...item,format:'full'},{...item,has_attachments:true},{...item,subject:null}])test('database rejects unselected, multiple or non-metadata payload '+JSON.stringify(value).slice(-45),async()=>{const c=await call('claim');await actor(f.ids.admin,session,'service_role');await deny(()=>commit(String(c.nonce),value),/invalid_item/);await f.owner();assert.equal((await f.db.query<{n:number}>('select count(*)::int n from private.crm_incoming')).rows[0].n,0);});
test('nonce mismatch cannot commit',async()=>{await call('claim');await actor(f.ids.admin,session,'service_role');await deny(()=>commit(randomUUID()));});
test('expired grant can still be stopped and read without reactivation',async()=>{await f.owner();await f.db.exec(`update private.crm_connections set enabled=false where id=${q(connection)}`);await actor();assert.deepEqual(await call('stop'),{state:'cancelled'});assert.deepEqual(await call('status'),{state:'cancelled'});});
test('Contacts result stored once with no contact application',async()=>{await f.owner();await f.db.exec(`update private.crm_connections set kind='contacts' where id=${q(connection)};update private.crm_bounded_grants set selection='{"kind":"contacts","external_id":"people/FAKE"}' where id=${q(grant)}`);await actor();const c=await call('claim');const contact={external_id:'people/FAKE',source_id:'FAKE',etag:'FAKE',deleted:false,names:['TESTFIXTURE'],emails:['fake@example.invalid'],phones:[],organizations:[]};await commit(String(c.nonce),contact);await f.owner();assert.equal((await f.db.query<{n:number}>('select count(*)::int n from private.crm_contact_points')).rows[0].n,0);assert.equal((await f.db.query<{n:number}>('select count(*)::int n from private.crm_contact_decisions')).rows[0].n,0);});
test('15-minute limit enforced at issuance and no grant for an expired session',async()=>{await f.owner();await f.db.exec(`update private.crm_connections set enabled=false where id=${q(connection)}`);await deny(()=>f.db.query(`select private.crm_bounded_issue(${q(connection)},${q(f.ids.admin)},${q(session)},'FAKE',clock_timestamp()+interval '16 minutes')`),/access_denied/);await f.db.exec(`update auth.sessions set not_after=clock_timestamp()-interval '1 minute' where id=${q(session)}`);await actor();await deny(()=>call('claim'),/access_denied/);});
test('completed grant can be revoked without deleting or cancelling received proof',async()=>{const c=await call('claim');await commit(String(c.nonce));await actor();assert.deepEqual(await call('stop'),{state:'done'});assert.deepEqual(await call('status'),{state:'done'});await f.owner();const row=(await f.db.query<{revoked:boolean;state:string}>(`select revoked_at is not null revoked,state from private.crm_bounded_grants where id=${q(grant)}`)).rows[0];assert.deepEqual(row,{revoked:true,state:'done'});assert.equal((await f.db.query<{n:number}>('select count(*)::int n from private.crm_incoming')).rows[0].n,1);});
test('Contacts full mock chain uses a real issued CONTACT selection, identity and one people.get',async()=>{
 await f.owner();const cid=randomUUID();await f.db.exec(`insert into private.crm_connections(id,organization_id,kind,owner_email,subject_id,enabled,valid_until,retain_until,created_by)values(${q(cid)},${q(f.ids.org)},'contacts','admin@fixture.invalid','FAKE',false,clock_timestamp()+interval '7 days',clock_timestamp()+interval '30 days',${q(f.ids.admin)});insert into private.crm_connection_access values(${q(cid)},${q(f.ids.admin)},true,false,false)`);
 grant=(await f.db.query<{v:string}>(`select private.crm_bounded_issue(${q(cid)},${q(f.ids.admin)},${q(session)},'people/FAKE',clock_timestamp()+interval '10 minutes') v`)).rows[0].v;
 await f.db.exec(`update private.crm_connections set enabled=true where id=${q(cid)}`);
 const requests:string[]=[];const transport:typeof fetch=async input=>{const url=String(input);requests.push(url);return new Response(JSON.stringify(url.includes('userinfo')?{sub:'FAKE',email:'admin@fixture.invalid',email_verified:true}:{resourceName:'people/FAKE',metadata:{sources:[{type:'CONTACT',id:'FAKE',etag:'FAKE'}]},names:[{displayName:'TESTFIXTURE - NIET PUBLICEREN'}],emailAddresses:[{value:'fake@example.invalid'}]}));};
 const port:BoundedOwner=async op=>{await actor();return call(op);};
 assert.deepEqual(await receiveBoundedCrm(grant,port,{provider:async()=>boundedGoogleProvider({token:'FAKE',scopes:['https://www.googleapis.com/auth/contacts.readonly']},transport),commit:async(_id,nonce,value)=>commit(nonce,value)},true),{state:'done'});
 assert.equal(requests.length,2);assert.ok(requests[1].includes('/v1/people/FAKE?'));assert.ok(!requests.some(x=>x.includes('/connections')));
 await actor();const view=(await f.db.query<{v:{incoming:{payload:{phones:unknown[];organizations:unknown[]}}[]}}>(`select public.crm_communication_owner(${q(f.ids.org)},'overview',${q(cid)}) v`)).rows[0].v;assert.equal(view.incoming.length,1);assert.deepEqual(view.incoming[0].payload.phones,[]);assert.deepEqual(view.incoming[0].payload.organizations,[]);
});
test('database independently rejects extra contact fields and actual phone data',async()=>{
 await f.owner();await f.db.exec(`update private.crm_connections set kind='contacts' where id=${q(connection)};update private.crm_bounded_grants set selection='{"kind":"contacts","external_id":"people/FAKE"}' where id=${q(grant)}`);await actor();const c=await call('claim');
 const base={external_id:'people/FAKE',source_id:'FAKE',etag:'FAKE',deleted:false,names:['TESTFIXTURE'],emails:['fake@example.invalid'],phones:[],organizations:[]};
 await actor(f.ids.admin,session,'service_role');for(const value of [{...base,phones:['+32000000000']},{...base,birthday:'FAKE'},{...base,emails:[123]},{...base,deleted:true}])await deny(()=>commit(String(c.nonce),value),/invalid_item/);
});
