 const supabase={from(table:string){calls.push(table);const query={select(){return query;},eq(){return query;},is(){return query;},limit(){return query;},in(){return query;},order(){return query;},then(resolve:(v:unknown)=>void){resolve({data:table==='email_communications'?[{id:job,title:'TESTFIXTURE concept',status:'draft'}]:table==='organization_members'?[{user_id:org,profiles:{display_name:'TESTFIXTURE account'}}]:[{id:org,display_name:'TESTFIXTURE Noor',name:'TESTFIXTURE Organisatie',title:'TESTFIXTURE Dossier',email:'person@fixture.invalid',updated_at:'2026-11-15'}],error:null});}};return query;},async rpc(name:string,args:Record<string,unknown>){rpc.push({name,...args});if(name==='crm_review_owner')return{data:[{id:job,incoming_id:job,entity_type:options.contacts?'community_person':'project',entity_id:org,state:'ready',expires_at:'2030-01-01',can_execute:true,can_stop:true}],error:options.reviewError?{message:'PRIVATE_REVIEW_ERROR'}:null};if(name==='crm_bounded_owner')return{data:[{id:job,state:'ready',expires_at:'2030-01-01',kind:options.contacts?'contacts':'gmail',can_receive:!options.boundedExpired,can_stop:true}],error:options.boundedError?{message:'PRIVATE_BOUND_ERROR'}:null};return{data:args.p_action==='connections'?[{id:connection,kind:options.contacts?'contacts':'gmail',owner_email:'mailbox@fixture.invalid'}]:data,error:options.error?{message:'PRIVATE_TOKEN_DO_NOT_LEAK'}:null};}};
